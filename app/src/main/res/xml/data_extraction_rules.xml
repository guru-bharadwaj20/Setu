<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through backup or device transfer. The identity
     seed is wrapped by a Keystore key that never migrates, so a restored copy
     could not be unwrapped anyway, and carried packets belong to other people. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
